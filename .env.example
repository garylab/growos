# Copy to .env and fill in. Never commit .env.

# --- Database (internal only; no host port is published)
POSTGRES_USER=growos
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=growos

# --- Application secrets
# Master key used to encrypt provider API keys at rest. Generate with:  openssl rand -hex 32
APP_SECRET_KEY=
# Shared access token required by the UI/API. Strongly recommended when exposed through a tunnel. Generate with: openssl rand -hex 24
APP_AUTH_TOKEN=

# --- URLs / ports
# Public URL users open (used for Google OAuth redirect URIs). With a Cloudflare tunnel: https://growos.example.com
PUBLIC_BASE_URL=http://localhost:8888
WEB_PORT=8888

# --- Google one-click connect (Search Console, Analytics 4) — one-time setup
# 1. Google Cloud Console → APIs & Services → enable "Google Search Console API" and "Google Analytics Data API"
#    (+ "Google Analytics Admin API" for property auto-detection).
# 2. OAuth consent screen → External (or Internal for Workspace), add yourself as a test user while in Testing.
# 3. Credentials → Create OAuth client ID → Web application → Authorized redirect URIs (add BOTH):
#      ${PUBLIC_BASE_URL}/api/integrations/google/oauth/callback   (data: Search Console / Analytics)
#      ${PUBLIC_BASE_URL}/api/auth/google/callback                 (login: "Sign in with Google")
#    e.g. https://growos.example.com/api/auth/google/callback
# 4. Paste the client ID and secret below. Then Integrations → "Connect with Google" is a single click, and the
#    sign-in screen shows a "Sign in with Google" button (signs in existing users whose verified email matches).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Google API key for PageSpeed Insights (Lighthouse) and Chrome UX Report. Without it PageSpeed uses a small shared quota
# that is often exhausted (HTTP 429). Cloud Console → APIs & Services → enable "PageSpeed Insights API" (+ "Chrome UX Report API")
# → Credentials → Create credentials → API key (restrict it to those two APIs).
GOOGLE_API_KEY=
# SerpApi key, shared by all three SerpApi providers: live SERP positions + keyword discovery (Keyword & SERP data),
# the AI answer surfaces sampled for GEO — Google AI Overview, AI Mode, Bing Copilot (AI answer providers) — and
# Extract, the JavaScript renderer used when a crawled page arrives as an empty app shell (Website crawling).
# serpapi.com → Dashboard → Your Private API Key. You still add a connection per provider under Integrations, since
# that is where the per-connection settings live (which AI surface, which SERP engine), but you can leave the key
# field blank and it will be taken from here. A key typed on a connection overrides this one.
SERPAPI_API_KEY=
# Google Gemini, for AI-visibility sampling and as the AI analyst. This is an AI Studio key
# (https://aistudio.google.com → Get API key), NOT the GOOGLE_API_KEY above: that one is a Cloud console key for
# PageSpeed/CrUX and is normally restricted to those two APIs, so it cannot serve Gemini. Add a Gemini connection
# under Integrations → AI answer providers and leave its key field blank to use this.
GEMINI_API_KEY=
# Bing Webmaster Tools, for first-party Bing clicks/impressions/position — a second search engine, and the
# measurable half of Microsoft Copilot visibility, since Copilot answers from Bing's index. Free.
# bing.com/webmasters → Settings → API access → API key. The key is account-wide, so this one value covers every
# site verified in the account. Add a Bing connection under Integrations and leave its key field blank to use this,
# then set each domain's Bing site URL under SEO Intelligence → Search performance.
BING_API_KEY=
# Raven Semrush backlink Actor on Apify. Requires a paid Apify plan. Add the connection under Integrations → Apify;
# leave its token field blank to use this deployment-wide value, or enter a project-specific token there.
APIFY_API_TOKEN=

# --- First administrator (created on first start when no users exist yet)
ADMIN_EMAIL=
ADMIN_PASSWORD=
SESSION_DAYS=30

# --- Email for weekly digests and alerts (optional). Without it, notifications still show in-app.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=growos@yourdomain.com
SMTP_STARTTLS=true

# Default monthly AI token budget per project (0 = unlimited). Override per project under Settings.
DEFAULT_MONTHLY_TOKEN_BUDGET=0

# --- Runtime
APP_ENV=production
LOG_LEVEL=INFO
WORKER_CONCURRENCY=2
CRAWL_MAX_URLS_DEFAULT=500
CRAWL_USER_AGENT=GrowOS-Crawler/0.1

# External API keys (OpenAI, Gemini, Search Console, PageSpeed...) are NOT set here.
# Add them in the UI under Integrations; they are encrypted with APP_SECRET_KEY and stored in PostgreSQL.

# --- Outbound fetch allowlist (optional)
# Hosts the SSRF guard may reach even though they resolve to a private address — for services you run next to
# GrowOS, e.g. an internal feed or aggregator a custom adapter fetches from. Accepts host or host:port.
# Comma separated. Leave empty unless you need it.
OUTBOUND_ALLOW_HOSTS=
